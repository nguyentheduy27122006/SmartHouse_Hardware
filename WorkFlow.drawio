        <!-- 3 MẠCH VI ĐIỀU KHIỂN ESP8266 NODEMCU -->
        <mxCell id="mcu1" value="«MCU #1 - tang_1_1.ino»&#xa;ESP8266 NodeMCU (Tầng 1.1)&#xa;Nhà xe, Chiếu sáng, Quạt, Khí hậu &amp; Chống trộm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontColor=#E65100;fontStyle=1;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="420" width="380" height="75" as="geometry" />
        </mxCell>

        <mxCell id="mcu2" value="«MCU #2 - tang_1_2.ino»&#xa;ESP8266 NodeMCU (Tầng 1.2)&#xa;Khóa Cửa Chính (Keypad) &amp; Thang Máy 3 Tầng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontColor=#E65100;fontStyle=1;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="420" width="380" height="75" as="geometry" />
        </mxCell>

        <mxCell id="mcu3" value="«MCU #3 - tang_2_3.ino»&#xa;ESP8266 NodeMCU (Tầng 2 &amp; 3)&#xa;Báo cháy MQ-2, Đèn T2, OLED &amp; Cửa Vân Tay AS608" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontColor=#E65100;fontStyle=1;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="420" width="380" height="75" as="geometry" />
        </mxCell>

        <mxCell id="e_fb_mcu1" value="HTTPS REST (BearSSL)&#xa;Chu kỳ 500ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8E24AA;strokeWidth=1.5;fontSize=11;startArrow=classic;startFill=1;" edge="1" parent="1" source="firebase" target="mcu1">
          <mxGeometry relative="1" as="geometry">
