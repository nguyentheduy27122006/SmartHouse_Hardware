        <!-- KHỐI NGOẠI VI MẠCH 1 (TẦNG 1.1) -->
        <mxCell id="grp1" value="Cụm Ngoại Vi Mạch 1 (Tầng 1.1)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CFD8DC;fontColor=#263238;fontStyle=1;fontSize=13;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="500" height="440" as="geometry" />
        </mxCell>
        <mxCell id="m1_s1" value="«Sensor - Chân D3»&#xa;Cảm biến Nhiệt độ &amp; Độ ẩm DHT11&#xa;(Đọc mỗi 2s -> Ghi temperature_1, humidity_1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=12;" vertex="1" parent="grp1">
          <mxGeometry x="30" y="50" width="440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="m1_s2" value="«Sensor - Chân D4»&#xa;Cảm biến Chống trộm Nhà xe (IR / PIR)&#xa;(Đọc alarm_enabled_1 -> Ghi alarm_triggered_1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=12;" vertex="1" parent="grp1">
          <mxGeometry x="30" y="120" width="440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="m1_a1" value="«Display - Chân D1 (SCL), D2 (SDA)»&#xa;Màn hình LCD 16x2 I2C (0x27)&#xa;(Hiển thị Nhiệt độ, Độ ẩm, Trạng thái An ninh &amp; Quạt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#D81B60;fontColor=#880E4F;fontSize=12;" vertex="1" parent="grp1">
          <mxGeometry x="30" y="190" width="440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="m1_a2" value="«Actuator - Chân D5 (IN1), D6 (IN2)»&#xa;Cửa cuốn Garage (L298N Kênh A - OUT1/OUT2)&#xa;(Mở PWM 90 / Đóng PWM 85 trong 300ms | garage/command &amp; status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#D81B60;fontColor=#880E4F;fontSize=12;" vertex="1" parent="grp1">
          <mxGeometry x="30" y="260" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m1_a3" value="«Actuator - Chân D7 (L298N IN3) &amp; Chân D0 (MOSFET)»&#xa;Quạt làm mát T1 (fan_room_1) &amp; Dãy Đèn LED T1 (light_room_1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#D81B60;fontColor=#880E4F;fontSize=12;" vertex="1" parent="grp1">
          <mxGeometry x="30" y="335" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_mcu1_grp1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FB8C00;strokeWidth=1.5;startArrow=classic;startFill=1;" edge="1" parent="1" source="mcu1" target="grp1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- KHỐI NGOẠI VI MẠCH 2 (TẦNG 1.2) -->
        <mxCell id="grp2" value="Cụm Ngoại Vi Mạch 2 (Tầng 1.2)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CFD8DC;fontColor=#263238;fontStyle=1;fontSize=13;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="550" width="480" height="440" as="geometry" />
        </mxCell>
        <mxCell id="m2_s1" value="«Input - Chân D1 (SCL), D2 (SDA)»&#xa;Bàn phím Ma trận 4x4 + Module I2C PCF8574 (0x20)&#xa;(Nhập mật khẩu &quot;111#&quot; -> Nhấn A mở cửa, C xóa, D đổi MK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=12;" vertex="1" parent="grp2">
          <mxGeometry x="25" y="50" width="430" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m2_a1" value="«Display - Chân D1 (SCL), D2 (SDA)»&#xa;Màn hình LCD 16x2 I2C Cửa chính (0x27)&#xa;(Hiển thị nhắc mật khẩu ****, trạng thái Mở cửa / Đổi MK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#D81B60;fontColor=#880E4F;fontSize=12;" vertex="1" parent="grp2">
          <mxGeometry x="25" y="135" width="430" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m2_a2" value="«Actuator - Chân D4»&#xa;Động cơ Servo SG90 Khóa Cửa chính&#xa;(Mở góc 20° trong 3000ms rồi đóng góc 100° | Tự bật light_room_1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#D81B60;fontColor=#880E4F;fontSize=12;" vertex="1" parent="grp2">
          <mxGeometry x="25" y="220" width="430" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m2_a3" value="«Actuator - Chân D5 (IN1 Lên), D6 (IN2 Xuống)»&#xa;Động cơ Thang máy 3 Tầng (L298N OUT1/OUT2)&#xa;(Đi lên PWM 200 / Đi xuống PWM 70 | target_floor, current_floor, status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#D81B60;fontColor=#880E4F;fontSize=12;" vertex="1" parent="grp2">
          <mxGeometry x="25" y="305" width="430" height="75" as="geometry" />
        </mxCell>

        <mxCell id="e_mcu2_grp2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FB8C00;strokeWidth=1.5;startArrow=classic;startFill=1;" edge="1" parent="1" source="mcu2" target="grp2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- KHỐI NGOẠI VI MẠCH 3 (TẦNG 2 & 3) -->
        <mxCell id="grp3" value="Cụm Ngoại Vi Mạch 3 (Tầng 2 &amp; Tầng 3)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CFD8DC;fontColor=#263238;fontStyle=1;fontSize=13;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="550" width="500" height="440" as="geometry" />
        </mxCell>
        <mxCell id="m3_s1" value="«Sensor - Chân A0 &amp; Nút nhấn D5»&#xa;[Tầng 2] Cảm biến Khói/Gas MQ-2 (Ngưỡng ADC 120, đọc 500ms)&#xa;&amp; Công tắc Nút nhấn vật lý bật/tắt đèn Tầng 2 (Debounce 50ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=12;" vertex="1" parent="grp3">
          <mxGeometry x="25" y="50" width="450" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m3_s2" value="«Sensor - Chân D7 (SoftRX), D8 (SoftTX)»&#xa;[Tầng 3] Cảm biến Vân tay Quang học AS608 (UART 57600 baud)&#xa;(Quét mỗi 150ms &amp; Hỗ trợ đăng ký vân tay qua lệnh Serial ENROLL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=12;" vertex="1" parent="grp3">
          <mxGeometry x="25" y="130" width="450" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m3_a1" value="«Actuator - Chân D6 (Đèn T2) &amp; Chân D1 (Còi Buzzer)»&#xa;[Tầng 2 &amp; 3] Đèn LED Tầng 2 (light_room_2) &amp; Còi Buzzer chung&#xa;(Kêu khi có khói &gt; 120 trừ khi buzzer_mute_2=true; bíp 300ms khi mở vân tay)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#D81B60;fontColor=#880E4F;fontSize=12;" vertex="1" parent="grp3">
          <mxGeometry x="25" y="210" width="450" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m3_a2" value="«Display - Chân D2 (SDA), D3 (SCL)»&#xa;[Tầng 2] Màn hình OLED 0.96&quot; SSD1306 I2C (0x3C)&#xa;(Hiển thị Loading, Smart Home WELCOME!, thông điệp &amp; Cảnh báo cháy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#D81B60;fontColor=#880E4F;fontSize=12;" vertex="1" parent="grp3">
          <mxGeometry x="25" y="290" width="450" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m3_a3" value="«Actuator - Chân D4»&#xa;[Tầng 3] Động cơ Servo SG90 Khóa Cửa Vân Tay&#xa;(Mở góc 180° trong 2000ms rồi đóng về 0° | Đồng bộ /home/door_status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#D81B60;fontColor=#880E4F;fontSize=12;" vertex="1" parent="grp3">
          <mxGeometry x="25" y="365" width="450" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_mcu3_grp3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FB8C00;strokeWidth=1.5;startArrow=classic;startFill=1;" edge="1" parent="1" source="mcu3" target="grp3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. Sơ Đồ Đấu Nối Chân (3 Mạch ESP8266)" id="wiring-v4">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- BẢNG 1: SƠ ĐỒ ĐẤU NỐI MẠCH 1 (tang_1_1.ino) -->
        <mxCell id="w_box1" value="MẠCH 1: ESP8266 NODEMCU #1 (tang_1_1.ino - Tầng 1.1)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FB8C00;fontColor=#E65100;fontStyle=1;fontSize=14;startSize=35;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="480" height="520" as="geometry" />
        </mxCell>
        <mxCell id="w1_text" value="• D0 (GPIO16)  ───►  Chân SIG/IN Module MOSFET ───► Dãy Đèn LED Tầng 1&#xa;&#xa;• D1 (GPIO5)   ───►  Chân SCL của Màn hình LCD 16x2 I2C (0x27)&#xa;&#xa;• D2 (GPIO4)   ───►  Chân SDA của Màn hình LCD 16x2 I2C (0x27)&#xa;&#xa;• D3 (GPIO0)   ───►  Chân DATA / OUT của Cảm biến DHT11 (VCC nối 3V3)&#xa;&#xa;• D4 (GPIO2)   ───►  Chân DO / OUT của Cảm biến Chống trộm Nhà xe&#xa;&#xa;• D5 (GPIO14)  ───►  Chân IN1 (L298N #1 - Kênh A) ───► Motor Cửa Garage (Mở)&#xa;&#xa;• D6 (GPIO12)  ───►  Chân IN2 (L298N #1 - Kênh A) ───► Motor Cửa Garage (Đóng)&#xa;&#xa;• D7 (GPIO13)  ───►  Chân IN3 (L298N #1 - Kênh B) ───► Quạt làm mát Tầng 1&#xa;                     (Chân IN4 nối GND; giữ nguyên Jumper ENA &amp; ENB trên L298N)&#xa;&#xa;• VIN (5V)     ───►  Chân VCC của LCD 16x2 I2C&#xa;&#xa;• 3V3          ───►  Chân VCC của DHT11 &amp; Cảm biến Chống trộm&#xa;&#xa;• GND          ───►  Nối chung GND của L298N #1, Nguồn ngoài, MOSFET, LCD, DHT11" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Consolas;" vertex="1" parent="w_box1">
          <mxGeometry x="20" y="50" width="440" height="450" as="geometry" />
        </mxCell>

        <!-- BẢNG 2: SƠ ĐỒ ĐẤU NỐI MẠCH 2 (tang_1_2.ino) -->
        <mxCell id="w_box2" value="MẠCH 2: ESP8266 NODEMCU #2 (tang_1_2.ino - Tầng 1.2)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontStyle=1;fontSize=14;startSize=35;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="480" height="520" as="geometry" />
        </mxCell>
        <mxCell id="w2_text" value="• D1 (GPIO5)   ───►  Bus I2C SCL chung:&#xa;                     ├─► Chân SCL của LCD 16x2 Cửa chính (0x27)&#xa;                     └─► Chân SCL (Pin 14) của Module PCF8574 (0x20 - Keypad 4x4)&#xa;&#xa;• D2 (GPIO4)   ───►  Bus I2C SDA chung:&#xa;                     ├─► Chân SDA của LCD 16x2 Cửa chính (0x27)&#xa;                     └─► Chân SDA (Pin 15) của Module PCF8574 (0x20 - Keypad 4x4)&#xa;                     (8 chân Keypad R1..R4, C1..C4 cắm vào P0..P7 của PCF8574)&#xa;&#xa;• D4 (GPIO2)   ───►  Dây Cam/Vàng (PWM) của Servo SG90 Khóa Cửa chính&#xa;                     (Góc đóng 100°, góc mở 20° trong 3 giây)&#xa;&#xa;• D5 (GPIO14)  ───►  Chân IN1 (L298N #2) ───► Motor Thang máy Đi LÊN (PWM 200)&#xa;&#xa;• D6 (GPIO12)  ───►  Chân IN2 (L298N #2) ───► Motor Thang máy Đi XUỐNG (PWM 70)&#xa;                     (Giữ Jumper ENA trên L298N #2; Motor đấu vào OUT1 &amp; OUT2)&#xa;&#xa;• D0, D3, D7   ───►  (Tùy chọn) Công tắc hành trình Tầng 1, 2, 3&#xa;&#xa;• VIN / 5V     ───►  VCC của LCD 16x2 &amp; Dây Đỏ (+5V) của Servo SG90&#xa;&#xa;• GND          ───►  Nối chung GND của L298N #2, Nguồn ngoài, Servo, LCD, PCF8574" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Consolas;" vertex="1" parent="w_box2">
          <mxGeometry x="20" y="50" width="440" height="450" as="geometry" />
        </mxCell>

        <!-- BẢNG 3: SƠ ĐỒ ĐẤU NỐI MẠCH 3 (tang_2_3.ino) -->
        <mxCell id="w_box3" value="MẠCH 3: ESP8266 NODEMCU #3 (tang_2_3.ino - Tầng 2 &amp; 3)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontColor=#0D47A1;fontStyle=1;fontSize=14;startSize=35;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="40" width="480" height="520" as="geometry" />
        </mxCell>
        <mxCell id="w3_text" value="• A0 (ADC0)    ───►  Chân AO (Analog) của Cảm biến Khói/Gas MQ-2 (Tầng 2)&#xa;&#xa;• D1 (GPIO5)   ───►  Cực Dương (+) của Còi Buzzer 5V (Báo cháy T2 + Báo vân tay T3)&#xa;&#xa;• D2 (GPIO4)   ───►  Chân SDA của Màn hình OLED 0.96&quot; SSD1306 I2C (0x3C - Tầng 2)&#xa;&#xa;• D3 (GPIO0)   ───►  Chân SCL của Màn hình OLED 0.96&quot; SSD1306 I2C (0x3C - Tầng 2)&#xa;&#xa;• D4 (GPIO2)   ───►  Dây Cam/Vàng (PWM) của Servo SG90 Khóa Cửa Tầng 3&#xa;                     (Góc mở 180° trong 2 giây, góc đóng 0°)&#xa;&#xa;• D5 (GPIO14)  ───►  Chân 1 của Nút nhấn vật lý bật/tắt đèn Tầng 2 (Chân 2 nối GND)&#xa;&#xa;• D6 (GPIO12)  ───►  Chân SIG/IN của MOSFET / Relay Đèn LED Tầng 2&#xa;&#xa;• D7 (GPIO13)  ───►  Chân TX (Dây Trắng/Vàng) của Cảm biến Vân tay AS608 (Tầng 3)&#xa;&#xa;• D8 (GPIO15)  ───►  Chân RX (Dây Xanh) của Cảm biến Vân tay AS608 (Tầng 3)&#xa;&#xa;• 3V3 / 5V     ───►  VCC của AS608 (3.3V), OLED (3.3V), MQ-2 (5V), Servo SG90 (5V)&#xa;&#xa;• GND          ───►  Nối chung GND toàn mạch" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Consolas;" vertex="1" parent="w_box3">
          <mxGeometry x="20" y="50" width="440" height="450" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
