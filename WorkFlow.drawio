        <mxCell id="e_fb_mcu3" value="HTTPS REST (BearSSL)&#xa;Chu kỳ 500ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8E24AA;strokeWidth=1.5;fontSize=11;startArrow=classic;startFill=1;" edge="1" parent="1" source="firebase" target="mcu3">
